# Конфигурация для Uniswap v3 Pool Analyzer

# URL сабграфа Uniswap v3 для Arbitrum One
# Актуальный URL можно получить из документации:
# - Uniswap Docs: https://docs.uniswap.org/api/subgraph/overview
# - The Graph: https://thegraph.com/hosted-service/subgraph/ianlapham/uniswap-arbitrum-one
#
# Примеры эндпоинтов:
# - Hosted Service: https://api.thegraph.com/subgraphs/name/ianlapham/uniswap-arbitrum-one
# - Decentralized Network: https://gateway.thegraph.com/api/[api-key]/subgraphs/id/[subgraph-id]
UNISWAP_V3_SUBGRAPH_URL=https://api.thegraph.com/subgraphs/name/ianlapham/uniswap-arbitrum-one

# RPC endpoint Arbitrum One (опционально, для будущих улучшений)
# Можно использовать публичный или свой от Infura/Alchemy/QuickNode
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# Если используешь The Graph decentralized network, укажи API ключ
# THE_GRAPH_API_KEY=your_api_key_here
