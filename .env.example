# Конфигурация для Uniswap v3 Pool Analyzer

# === Uniswap V3 Subgraph для Arbitrum One ===
#
# Используется ТОЛЬКО основной Uniswap V3 Arbitrum subgraph.
# Позиции LP строятся из событий Mint/Burn/Collect (positions subgraph больше не нужен).
#
# Документация: https://docs.uniswap.org/api/subgraph/overview

# Основной Uniswap V3 Arbitrum Subgraph
# Subgraph ID: FbCGRftH4a3yZugY7TnbYgPJVEv2LvMT6oF1fxPe9aJM
# Содержит: pools, ticks, tokens, swaps, mints, burns, collects
UNISWAP_V3_SUBGRAPH_URL=https://gateway.thegraph.com/api/YOUR_API_KEY/subgraphs/id/FbCGRftH4a3yZugY7TnbYgPJVEv2LvMT6oF1fxPe9aJM

# === Получить API ключ ===
# 1. Зарегистрируйтесь: https://thegraph.com/studio/
# 2. Создайте API ключ в разделе "API Keys"
# 3. Замените YOUR_API_KEY на ваш ключ в URL выше
#
# Пример:
# UNISWAP_V3_SUBGRAPH_URL=https://gateway.thegraph.com/api/abc123def456/subgraphs/id/FbCGRftH4a3yZugY7TnbYgPJVEv2LvMT6oF1fxPe9aJM

# === Альтернатива: Hosted Service (deprecated, может не работать) ===
# UNISWAP_V3_SUBGRAPH_URL=https://api.thegraph.com/subgraphs/name/ianlapham/uniswap-arbitrum-one

# RPC endpoint Arbitrum One (опционально, для будущих улучшений)
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
