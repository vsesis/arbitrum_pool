# Конфигурация для Uniswap v3 Pool Analyzer

# === Uniswap V3 Subgraphs для Arbitrum One ===
#
# ВАЖНО: Для работы приложения ОБЯЗАТЕЛЬНО нужен основной subgraph.
# Positions subgraph - опциональный (если не настроен, позиции будут недоступны).
#
# Документация: https://docs.uniswap.org/api/subgraph/overview

# 1. Основной Uniswap V3 Arbitrum Subgraph (ОБЯЗАТЕЛЬНО)
#    Subgraph ID: FbCGRftH4a3yZugY7TnbYgPJVEv2LvMT6oF1fxPe9aJM
#    Содержит: pools, ticks, swaps, mints, burns, collects
#    Используется для: Pool Overview, Liquidity Distribution
UNISWAP_V3_ARBITRUM_SUBGRAPH=https://gateway.thegraph.com/api/<API_KEY>/subgraphs/id/FbCGRftH4a3yZugY7TnbYgPJVEv2LvMT6oF1fxPe9aJM

# 2. Uniswap V3 User Positions Arbitrum Subgraph (ОПЦИОНАЛЬНЫЙ)
#    ВНИМАНИЕ: Официальный positions subgraph имеет несовместимую схему!
#    Subgraph ID EKfnW8Ss1MMNhb8psVRsotcXmeweLgBtKQBG6wayPLBG НЕ ПОДХОДИТ
#
#    Варианты решения:
#    а) Оставьте тот же URL, что и для основного subgraph (приложение попробует найти positions там)
#    б) Найдите альтернативный subgraph на https://thegraph.com/explorer
#    в) Оставьте закомментированным - приложение будет работать без positions
#
# UNISWAP_V3_POSITIONS_ARBITRUM_SUBGRAPH=https://gateway.thegraph.com/api/<API_KEY>/subgraphs/id/FbCGRftH4a3yZugY7TnbYgPJVEv2LvMT6oF1fxPe9aJM

# === Получить API ключ ===
# 1. Зарегистрируйтесь: https://thegraph.com/studio/
# 2. Создайте API ключ в разделе "API Keys"
# 3. Замените <API_KEY> на ваш ключ в URL выше
#
# Пример с вашим API ключом:
# UNISWAP_V3_ARBITRUM_SUBGRAPH=https://gateway.thegraph.com/api/abc123def456/subgraphs/id/FbCGRftH4a3yZugY7TnbYgPJVEv2LvMT6oF1fxPe9aJM

# === Что будет работать без UNISWAP_V3_POSITIONS_ARBITRUM_SUBGRAPH ===
# ✅ РАБОТАЕТ:
#    - GET /api/pool/{address}/summary - информация о пуле
#    - GET /api/pool/{address}/liquidity - график распределения ликвидности
#
# ❌ НЕ РАБОТАЕТ (вернет ошибку):
#    - GET /api/pool/{address}/lp-summary - агрегация по LP
#    - GET /api/pool/{address}/positions - список позиций
#    - GET /api/pool/{address}/csv/{type} - экспорт CSV
#
# Веб-интерфейс покажет Pool Overview и Liquidity Distribution,
# но вкладки LP Overview и Positions будут показывать ошибку.

# RPC endpoint Arbitrum One (опционально, для будущих улучшений)
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
